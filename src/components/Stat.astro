---
interface Props {
  value: string;
  unit?: string;
  label: string;
  size?: 'md' | 'lg';
  accent?: boolean;
  class?: string;
}

const { value, unit, label, size = 'md', accent = false, class: className } = Astro.props;
---

<div class:list={['stat', `stat--${size}`, { 'stat--accent': accent }, className]}>
  <p class="stat__value">{value}{unit && <span class="stat__unit">{unit}</span>}</p>
  <p class:list={size === 'md' ? 'label' : 'stat__label'}>{label}</p>
  {
    Astro.slots.has('default') && (
      <p class="stat__note">
        <slot />
      </p>
    )
  }
</div>

<style lang="scss">
  .stat {
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
    border-left: 1px solid var(--rule);
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: var(--t-stat);
    font-weight: var(--weight-regular);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    color: var(--fg1);

    .stat--lg & {
      font-size: var(--t-stat-lg);
    }

    .stat--accent & {
      color: var(--accent);
    }
  }

  .stat__unit {
    margin-left: var(--s-1);
    font-size: 0.5em;
    color: var(--fg3);

    .stat--accent & {
      color: inherit;
    }
  }

  .stat__label {
    color: var(--fg2);
  }

  .stat__note {
    max-width: var(--measure-note);
    font-size: var(--t-small);
  }
</style>
