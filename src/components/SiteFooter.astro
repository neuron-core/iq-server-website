---
import Logo from './Logo.astro';
import { CONTACT, NAV, PAGES, SITE_NAME } from '../consts/site';
import { ARCHITECTURES } from '../consts/product';
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <a class="footer__brand" href={PAGES.home} aria-label={`${SITE_NAME} home`}><Logo /></a>
        <p class="footer__tag">The streaming layer AI products should have had from the start. Built for tokens.</p>
      </div>
      <nav aria-label="Website">
        <h2 class="label">Website</h2>
        <ul>{NAV.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Contact">
        <h2 class="label">Contact</h2>
        <ul><li><a href={CONTACT.href} target="_blank" rel="noopener">{CONTACT.label} ↗</a></li></ul>
      </nav>
    </div>
    <div class="footer__bottom label">
      <span>{SITE_NAME} · LLM streaming server</span>
      <span>{[...ARCHITECTURES, 'signed releases'].join(' · ')}</span>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    padding-block: var(--s-8) var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .footer__top {
    display: grid;
    gap: var(--s-6) var(--s-7);
    padding-bottom: var(--s-7);

    @include up(md) {
      grid-template-columns: 2fr 1fr 1fr;
    }

    ul {
      display: grid;
      gap: var(--s-2);
      margin-top: var(--s-4);
    }

    ul a {
      font-size: var(--t-small);
      color: var(--fg2);

      &:hover {
        color: var(--accent);
      }
    }
  }

  .footer__brand {
    text-decoration: none;
  }

  .footer__tag {
    max-width: var(--measure-note);
    margin-top: var(--s-4);
    font-size: var(--t-caption);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }
</style>
