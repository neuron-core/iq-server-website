---
import CodeBlock from '../CodeBlock.astro';

// Illustration: one answer streamed as SSE, with a reconnect in the middle.
const EVENT = 'TEXT_MESSAGE_CONTENT';
const before = [
  { id: 211, delta: 'Streaming' },
  { id: 212, delta: ' resumes' },
];
const after = [
  { id: 213, delta: ' exactly' },
  { id: 214, delta: ' here.' },
];
const lastSeen = before[before.length - 1]!.id;
const ids = (events: typeof before) => events.map((event) => event.id).join(' and ');
const description = `An SSE stream from IQ: events ${ids(before)} arrive, the connection drops, the browser reconnects with Last-Event-ID ${lastSeen}, and events ${ids(after)} follow with no gap.`;
---

<CodeBlock labels={['text/event-stream', 'one answer · one browser']} description={description}>
  <div class="tok-c">// each chunk, relayed as the model writes it</div>
  {
    before.map(({ id, delta }) => (
      <div class="event">
        <div><span class="tok-p">id: </span>{id}</div>
        <div><span class="tok-p">event: </span>{EVENT}</div>
        <div><span class="tok-p">data: </span>{JSON.stringify({ delta })}</div>
      </div>
    ))
  }
  <div class="drop">connection drops · EventSource reconnects</div>
  <div><span class="tok-p">Last-Event-ID: </span>{lastSeen}</div>
  <div class="tok-c">// replayed from memory, then live again</div>
  {
    after.map(({ id, delta }) => (
      <div class="event">
        <div><span class="tok-p">id: </span>{id}</div>
        <div><span class="tok-p">event: </span>{EVENT}</div>
        <div><span class="tok-p">data: </span>{JSON.stringify({ delta })}</div>
      </div>
    ))
  }
</CodeBlock>

<style lang="scss">
  .event {
    margin-top: var(--s-3);
  }

  .drop {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block: var(--s-4);
    padding-block: var(--s-3);
    border-block: 1px solid var(--rule);
    color: var(--fg2);

    &::before {
      content: '';
      flex: none;
      width: 0.5em;
      height: 0.5em;
      background: var(--fg1);
    }
  }
</style>
